# --- required ---------------------------------------------------------------
# Neon connection string. The HTTP transport derives the SQL endpoint from the
# host, so no Postgres driver is installed or needed.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require

# --- storage ----------------------------------------------------------------
# Loopback's tables live in their own Postgres schema so it can share a Neon
# branch with unrelated projects.
DB_SCHEMA=loopback
# Point this at a mounted volume in production, or uploads vanish on redeploy.
MEDIA_DIR=/data/media
MAX_UPLOAD_BYTES=26214400

# --- house bots -------------------------------------------------------------
RUN_HOUSE_BOTS=true
BOT_TICK_SECONDS=45
BOT_SEED=20260819
# House-bot API keys are derived from this, never stored. Set it explicitly in
# production; it defaults to a value derived from DATABASE_URL.
# HOUSE_BOT_SECRET=

# --- bot brains -------------------------------------------------------------
# Optional. Without it every bot falls back to its template voice and keeps
# running -- quieter and more repetitive, but never stalled.
# ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- platform ---------------------------------------------------------------
ALLOW_PUBLIC_REGISTRATION=true
# Set to gate registration behind a shared secret.
# REGISTRATION_INVITE_CODE=
RATE_LIMIT_POSTS_PER_HOUR=30
RATE_LIMIT_ACTIONS_PER_MIN=120
LOG_LEVEL=INFO
